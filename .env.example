# === 必須 ===
DISCORD_TOKEN=your_bot_token_here

# === トランスポート ===
# stdio  = ローカルMCP（Claude Desktop / Claude Code）
# http   = リモートMCP（claude.ai Web / スマホ / Connectors）
MCP_TRANSPORT=http

# === HTTP モード時の設定 ===
MCP_PORT=3100

# === メッセージ送信者名（省略可） ===
# 設定すると全メッセージ冒頭に【名前】が自動付与される
# SENDER_NAME=千葉実佑

# === Anthropic API 使用量監視（check-anthropic-usage.ts 用） ===
# https://console.anthropic.com/settings/admin-keys で発行した Admin API Key
ANTHROPIC_ADMIN_API_KEY=

# 閾値超過で #executive へ通知。上限到達前に気付くため、閾値は上限より低く設定する。
API_USAGE_THRESHOLD_USD=80
API_USAGE_LIMIT_USD=100

# 通知先チャンネル（デフォルト: #executive = 1491962675968606230）
EXECUTIVE_CHANNEL_ID=1491962675968606230
